generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCE_ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  password             String?
  name                 String?
  contact              String?
  role                 Role                 @default(USER)
  membersAdded         Member[]             @relation("MemberAddedBy")
  transactionsRecorded Transaction[]        @relation("TransactionRecordedBy")
  attendancesRecorded  Attendance[]         @relation("AttendanceRecordedBy")
  soulWinsRecorded     SoulWin[]            @relation("SoulWinRecordedBy")
  soulWinningGoals     SoulWinningGoal[]    @relation("SoulWinningGoalCreatedBy")
  activityLogs         ActivityLog[]
  refreshTokens        RefreshToken[]
  passwordSetupTokens  PasswordSetupToken[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordSetupToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_setup_tokens")
}

enum ActivityAction {
  MEMBER_REGISTERED
  MEMBER_STATUS_CHANGED
  MEMBER_UPDATED
  MEMBER_DELETED
  INCOME_RECORDED
  EXPENSE_RECORDED
  USER_LOGGED_IN
  SOUL_WON
  SOUL_BAPTIZED
}

model ActivityLog {
  id        String         @id @default(uuid())
  action    ActivityAction
  message   String
  detail    String?
  metadata  Json?
  actor     User?          @relation(fields: [actorId], references: [id])
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("activity_logs")
}

model Status {
  id        String   @id @default(uuid())
  name      String   @unique
  members   Member[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("statuses")
}

model Group {
  id        String        @id @default(uuid())
  role      String
  members   MemberGroup[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("groups")
}

model MemberGroup {
  member            Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId          String
  group             Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId           String
  level             Level?           @relation(fields: [levelId], references: [id])
  levelId           String?
  lighthouseGroup   LighthouseGroup? @relation(fields: [lighthouseGroupId], references: [id])
  lighthouseGroupId String?
  createdAt         DateTime         @default(now())

  @@id([memberId, groupId])
  @@index([groupId])
  @@index([levelId])
  @@index([lighthouseGroupId])
  @@map("member_groups")
}

model Level {
  id        String        @id @default(uuid())
  name      String        @unique
  members   MemberGroup[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("levels")
}

model LighthouseGroup {
  id        String        @id @default(uuid())
  name      String        @unique
  members   MemberGroup[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("lighthouse_groups")
}

model Member {
  id          String        @id @default(uuid())
  email       String?
  firstName   String
  middleName  String?
  lastName    String
  contact     String?
  address     String?
  age         Int?
  birthDate   DateTime?
  gender      Gender?
  isBaptized  Boolean       @default(false)
  baptizedAt  DateTime?
  soulWinner  String?
  groups      MemberGroup[]
  status      Status?       @relation(fields: [statusId], references: [id])
  statusId    String?
  addedByUser User?         @relation("MemberAddedBy", fields: [addedBy], references: [id])
  addedBy     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  transactions Transaction[]
  attendances  Attendance[]
  soulWinsAsWinner SoulWinWinner[]
  soulWinAsConvert SoulWin?        @relation("SoulWinAsMember")

  @@index([statusId])
  @@index([createdAt])
  @@map("members")
}

model SoulWin {
  id             String          @id @default(uuid())
  firstName      String
  middleName     String?
  lastName       String
  contact        String?
  location       String?
  /// Approximate age of the convert at the time they were won.
  age            Int?
  /// Free-text occasion (e.g. "Sunday Service", "Campus Outreach") — not a separate events module.
  event          String?
  notes          String?
  wonAt          DateTime        @db.Date
  baptizedAt     DateTime?
  winners        SoulWinWinner[]
  member         Member?         @relation("SoulWinAsMember", fields: [memberId], references: [id])
  memberId       String?         @unique
  recordedByUser User?           @relation("SoulWinRecordedBy", fields: [recordedBy], references: [id])
  recordedBy     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([wonAt])
  @@index([baptizedAt])
  @@index([event])
  @@map("soul_wins")
}

/// Many members can share credit for one soul win.
model SoulWinWinner {
  soulWin   SoulWin  @relation(fields: [soulWinId], references: [id], onDelete: Cascade)
  soulWinId String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  memberId  String
  /// Display / primary order (0 = first / primary).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@id([soulWinId, memberId])
  @@index([memberId, soulWinId])
  @@map("soul_win_winners")
}

model SoulWinningGoal {
  id            String   @id @default(uuid())
  period        String
  startAt       DateTime
  endAt         DateTime
  targetCount   Int
  year          Int?     @unique
  createdByUser User?    @relation("SoulWinningGoalCreatedBy", fields: [createdBy], references: [id])
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([period, startAt, endAt])
  @@index([startAt, endAt])
  @@map("soul_winning_goals")
}

model TransactionType {
  id           String        @id @default(uuid())
  name         String        @unique
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("transaction_types")
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("categories")
}

model OfferingType {
  id        String            @id @default(uuid())
  name      String            @unique
  items     TransactionItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("offering_types")
}

model Transaction {
  id             String            @id @default(uuid())
  member         Member?           @relation(fields: [memberId], references: [id])
  memberId       String?
  type           TransactionType   @relation(fields: [typeId], references: [id])
  typeId         String
  category       Category?         @relation(fields: [categoryId], references: [id])
  categoryId     String?
  description    String?
  amount         Decimal           @db.Decimal(12, 2)
  items          TransactionItem[]
  recordedByUser User?             @relation("TransactionRecordedBy", fields: [recordedBy], references: [id])
  recordedBy     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([typeId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([memberId])
  @@index([typeId, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id             String       @id @default(uuid())
  transaction    Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId  String
  offeringType   OfferingType @relation(fields: [offeringTypeId], references: [id])
  offeringTypeId String
  amount         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  @@index([transactionId])
  @@index([offeringTypeId])
  @@map("transaction_items")
}

// One row per member per calendar day. Session times are nullable — unchecked
// boxes stay null. Attendance status (full day / morning only / etc.) is
// derived from which of the four timestamps are set, not stored.
model Attendance {
  id             String    @id @default(uuid())
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       String
  date           DateTime  @db.Date
  morningIn      DateTime?
  morningOut     DateTime?
  afternoonIn    DateTime?
  afternoonOut   DateTime?
  recordedByUser User?     @relation("AttendanceRecordedBy", fields: [recordedBy], references: [id])
  recordedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([memberId, date])
  @@index([date])
  @@index([recordedBy])
  @@map("attendances")
}
