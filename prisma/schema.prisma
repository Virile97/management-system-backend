generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCE_ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  password             String?
  name                 String?
  contact              String?
  role                 Role                 @default(USER)
  membersAdded         Member[]             @relation("MemberAddedBy")
  transactionsRecorded Transaction[]        @relation("TransactionRecordedBy")
  attendancesRecorded  Attendance[]         @relation("AttendanceRecordedBy")
  soulWinsRecorded     SoulWin[]            @relation("SoulWinRecordedBy")
  soulWinningGoals     SoulWinningGoal[]    @relation("SoulWinningGoalCreatedBy")
  activityLogs         ActivityLog[]
  refreshTokens        RefreshToken[]
  passwordSetupTokens  PasswordSetupToken[]
  foldersCreated       Folder[]             @relation("FolderCreatedBy")
  filesUploaded        StorageFile[]        @relation("StorageFileUploadedBy")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordSetupToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_setup_tokens")
}

enum ActivityAction {
  MEMBER_REGISTERED
  MEMBER_STATUS_CHANGED
  MEMBER_UPDATED
  MEMBER_DELETED
  INCOME_RECORDED
  EXPENSE_RECORDED
  USER_LOGGED_IN
  SOUL_WON
  SOUL_BAPTIZED
}

model ActivityLog {
  id        String         @id @default(uuid())
  action    ActivityAction
  message   String
  detail    String?
  metadata  Json?
  actor     User?          @relation(fields: [actorId], references: [id])
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("activity_logs")
}

model Status {
  id        String   @id @default(uuid())
  name      String   @unique
  members   Member[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("statuses")
}

model Group {
  id        String        @id @default(uuid())
  role      String
  members   MemberGroup[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("groups")
}

model MemberGroup {
  member            Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId          String
  group             Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId           String
  level             Level?           @relation(fields: [levelId], references: [id])
  levelId           String?
  lighthouseGroup   LighthouseGroup? @relation(fields: [lighthouseGroupId], references: [id])
  lighthouseGroupId String?
  createdAt         DateTime         @default(now())

  @@id([memberId, groupId])
  @@index([groupId])
  @@index([levelId])
  @@index([lighthouseGroupId])
  @@map("member_groups")
}

model Level {
  id        String        @id @default(uuid())
  name      String        @unique
  members   MemberGroup[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("levels")
}

model LighthouseGroup {
  id        String        @id @default(uuid())
  name      String        @unique
  members   MemberGroup[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("lighthouse_groups")
}

model Member {
  id          String        @id @default(uuid())
  email       String?
  firstName   String
  middleName  String?
  lastName    String
  contact     String?
  address     String?
  age         Int?
  birthDate   DateTime?
  gender      Gender?
  isBaptized  Boolean       @default(false)
  baptizedAt  DateTime?
  /// Marks a member as a New Believers Class student (curriculum track).
  isNewBeliever Boolean     @default(false)
  soulWinner  String?
  groups      MemberGroup[]
  status      Status?       @relation(fields: [statusId], references: [id])
  statusId    String?
  addedByUser User?         @relation("MemberAddedBy", fields: [addedBy], references: [id])
  addedBy     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  transactions Transaction[]
  attendances  Attendance[]
  soulWinsAsWinner SoulWinWinner[]
  soulWinAsConvert SoulWin?        @relation("SoulWinAsMember")
  nbcEnrollmentsAsStudent NbcEnrollment[] @relation("NbcStudent")
  nbcEnrollmentsAsTeacher NbcEnrollment[] @relation("NbcTeacher")

  @@index([statusId])
  @@index([createdAt])
  @@index([isNewBeliever])
  @@map("members")
}

model SoulWin {
  id             String          @id @default(uuid())
  firstName      String
  middleName     String?
  lastName       String
  contact        String?
  location       String?
  /// Approximate age of the convert at the time they were won.
  age            Int?
  /// Free-text occasion (e.g. "Sunday Service", "Campus Outreach") — not a separate events module.
  event          String?
  notes          String?
  wonAt          DateTime        @db.Date
  baptizedAt     DateTime?
  winners        SoulWinWinner[]
  member         Member?         @relation("SoulWinAsMember", fields: [memberId], references: [id])
  memberId       String?         @unique
  recordedByUser User?           @relation("SoulWinRecordedBy", fields: [recordedBy], references: [id])
  recordedBy     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([wonAt])
  @@index([baptizedAt])
  @@index([event])
  @@map("soul_wins")
}

/// Many members can share credit for one soul win.
model SoulWinWinner {
  soulWin   SoulWin  @relation(fields: [soulWinId], references: [id], onDelete: Cascade)
  soulWinId String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  memberId  String
  /// Display / primary order (0 = first / primary).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@id([soulWinId, memberId])
  @@index([memberId, soulWinId])
  @@map("soul_win_winners")
}

model SoulWinningGoal {
  id            String   @id @default(uuid())
  period        String
  startAt       DateTime
  endAt         DateTime
  targetCount   Int
  year          Int?     @unique
  createdByUser User?    @relation("SoulWinningGoalCreatedBy", fields: [createdBy], references: [id])
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([period, startAt, endAt])
  @@index([startAt, endAt])
  @@map("soul_winning_goals")
}

model TransactionType {
  id           String        @id @default(uuid())
  name         String        @unique
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("transaction_types")
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("categories")
}

model OfferingType {
  id        String            @id @default(uuid())
  name      String            @unique
  items     TransactionItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("offering_types")
}

model Transaction {
  id             String            @id @default(uuid())
  member         Member?           @relation(fields: [memberId], references: [id])
  memberId       String?
  type           TransactionType   @relation(fields: [typeId], references: [id])
  typeId         String
  category       Category?         @relation(fields: [categoryId], references: [id])
  categoryId     String?
  description    String?
  amount         Decimal           @db.Decimal(12, 2)
  items          TransactionItem[]
  recordedByUser User?             @relation("TransactionRecordedBy", fields: [recordedBy], references: [id])
  recordedBy     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([typeId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([memberId])
  @@index([typeId, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id             String       @id @default(uuid())
  transaction    Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId  String
  offeringType   OfferingType @relation(fields: [offeringTypeId], references: [id])
  offeringTypeId String
  amount         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  @@index([transactionId])
  @@index([offeringTypeId])
  @@map("transaction_items")
}

// One row per member per calendar day. Session times are nullable — unchecked
// boxes stay null. Attendance status (full day / morning only / etc.) is
// derived from which of the four timestamps are set, not stored.
model Attendance {
  id             String    @id @default(uuid())
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       String
  date           DateTime  @db.Date
  morningIn      DateTime?
  morningOut     DateTime?
  afternoonIn    DateTime?
  afternoonOut   DateTime?
  recordedByUser User?     @relation("AttendanceRecordedBy", fields: [recordedBy], references: [id])
  recordedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([memberId, date])
  @@index([date])
  @@index([recordedBy])
  @@map("attendances")
}

enum NbcEnrollmentStatus {
  ON_TRACK
  BEHIND
  ADVANCED
}

/// Curriculum catalog for New Believers Class. Admins can add/reorder lessons.
model NbcLesson {
  id          String   @id @default(uuid())
  /// Display / sequence number (1-based). Unique among active lessons.
  sortOrder   Int
  title       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments NbcEnrollment[]  @relation("NbcCurrentLesson")
  eventsFrom  NbcLessonEvent[] @relation("NbcEventFromLesson")
  eventsTo    NbcLessonEvent[] @relation("NbcEventToLesson")

  @@unique([sortOrder])
  @@index([isActive, sortOrder])
  @@map("nbc_lessons")
}

/// One active class seat per new-believer student (member).
/// Teachers are also members — identified by membership in the
/// "New Believers Teachers" ministry/group (see NBC_TEACHER_GROUP_ROLE).
model NbcEnrollment {
  id              String              @id @default(uuid())
  student         Member              @relation("NbcStudent", fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String              @unique
  teacher         Member              @relation("NbcTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  teacherId       String
  currentLesson   NbcLesson           @relation("NbcCurrentLesson", fields: [currentLessonId], references: [id], onDelete: Restrict)
  currentLessonId String
  status          NbcEnrollmentStatus @default(ON_TRACK)
  enrolledAt      DateTime            @default(now())
  graduatedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  events          NbcLessonEvent[]

  @@index([teacherId])
  @@index([currentLessonId])
  @@index([status])
  @@map("nbc_enrollments")
}

/// Audit trail when a student is enrolled or moved between lessons.
model NbcLessonEvent {
  id           String      @id @default(uuid())
  enrollment   NbcEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  fromLesson   NbcLesson?  @relation("NbcEventFromLesson", fields: [fromLessonId], references: [id], onDelete: SetNull)
  fromLessonId String?
  toLesson     NbcLesson   @relation("NbcEventToLesson", fields: [toLessonId], references: [id], onDelete: Restrict)
  toLessonId   String
  /// ENROLL | MOVE | COMPLETE
  type         String
  note         String?
  actorUserId  String?
  createdAt    DateTime    @default(now())

  @@index([enrollmentId, createdAt])
  @@index([toLessonId])
  @@map("nbc_lesson_events")
}

enum StorageFileType {
  VIDEO
  AUDIO
  PDF
  IMAGE
  DOCUMENT
  OTHER
}

/// Real nested folder hierarchy for the shared org-wide file library.
/// Self-referencing via parentId (null = root level).
model Folder {
  id            String        @id @default(uuid())
  name          String
  parent        Folder?       @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Restrict)
  parentId      String?
  children      Folder[]      @relation("FolderChildren")
  files         StorageFile[]
  createdByUser User?         @relation("FolderCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([parentId])
  @@index([parentId, name])
  @@map("folders")
}

/// Shared org-wide file library (Supabase Storage). Visibility is not
/// owner-restricted — any authenticated user can list/download; only ADMIN
/// can upload/rename/delete/move. uploadedBy is kept for audit only.
/// All access to bytes goes through short-lived signed URLs (see
/// file-storage.service.js#getDownloadUrl) — storagePath/bucket are never
/// exposed directly to clients.
model StorageFile {
  id              String          @id @default(uuid())
  name            String
  originalName    String
  folder          Folder?         @relation(fields: [folderId], references: [id], onDelete: Restrict)
  folderId        String?
  bucket          String
  storagePath     String          @unique
  mimeType        String
  sizeBytes       BigInt
  fileType        StorageFileType
  tags            String[]        @default([])
  uploadedByUser  User?           @relation("StorageFileUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)
  uploadedBy      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([folderId])
  @@index([fileType])
  @@index([createdAt])
  @@index([folderId, fileType])
  @@map("storage_files")
}
