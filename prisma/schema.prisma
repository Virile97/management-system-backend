generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCE_ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  password             String
  name                 String?
  role                 Role          @default(USER)
  membersAdded         Member[]      @relation("MemberAddedBy")
  transactionsRecorded Transaction[] @relation("TransactionRecordedBy")
  activityLogs         ActivityLog[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("users")
}

enum ActivityAction {
  MEMBER_REGISTERED
  MEMBER_STATUS_CHANGED
  MEMBER_UPDATED
  MEMBER_DELETED
  INCOME_RECORDED
  EXPENSE_RECORDED
  USER_LOGGED_IN
}

model ActivityLog {
  id        String         @id @default(uuid())
  action    ActivityAction
  message   String
  detail    String?
  metadata  Json?
  actor     User?          @relation(fields: [actorId], references: [id])
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([createdAt])
  @@map("activity_logs")
}

model Status {
  id        String   @id @default(uuid())
  name      String   @unique
  members   Member[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("statuses")
}

model Group {
  id        String        @id @default(uuid())
  role      String
  members   MemberGroup[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("groups")
}

model MemberGroup {
  member            Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId          String
  group             Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId           String
  level             Level?           @relation(fields: [levelId], references: [id])
  levelId           String?
  lighthouseGroup   LighthouseGroup? @relation(fields: [lighthouseGroupId], references: [id])
  lighthouseGroupId String?
  createdAt         DateTime         @default(now())

  @@id([memberId, groupId])
  @@index([groupId])
  @@index([levelId])
  @@index([lighthouseGroupId])
  @@map("member_groups")
}

model Level {
  id        String        @id @default(uuid())
  name      String        @unique
  members   MemberGroup[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("levels")
}

model LighthouseGroup {
  id        String        @id @default(uuid())
  name      String        @unique
  members   MemberGroup[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("lighthouse_groups")
}

model Member {
  id          String        @id @default(uuid())
  email       String?
  firstName   String
  middleName  String?
  lastName    String
  contact     String?
  address     String?
  age         Int?
  birthDate   DateTime?
  gender      Gender?
  isBaptized  Boolean       @default(false)
  baptizedAt  DateTime?
  soulWinner  String?
  groups      MemberGroup[]
  status      Status?       @relation(fields: [statusId], references: [id])
  statusId    String?
  addedByUser User?         @relation("MemberAddedBy", fields: [addedBy], references: [id])
  addedBy     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  transactions Transaction[]

  @@index([statusId])
  @@map("members")
}

model TransactionType {
  id           String        @id @default(uuid())
  name         String        @unique
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("transaction_types")
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("categories")
}

model Transaction {
  id             String          @id @default(uuid())
  member         Member?         @relation(fields: [memberId], references: [id])
  memberId       String?
  type           TransactionType @relation(fields: [typeId], references: [id])
  typeId         String
  category       Category?       @relation(fields: [categoryId], references: [id])
  categoryId     String?
  description    String?
  amount         Decimal         @db.Decimal(12, 2)
  recordedByUser User?           @relation("TransactionRecordedBy", fields: [recordedBy], references: [id])
  recordedBy     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([typeId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([memberId])
  @@map("transactions")
}
