NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

DATABASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=
JWT_EXPIRES_IN=7d

APP_API_KEY=

FRONTEND_URL=http://localhost:3000
APP_NAME=Management System

RATE_LIMIT_WINDOW_MS=900000
