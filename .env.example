NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# If this points at a connection pooler (e.g. Supabase's Supavisor/PgBouncer
# pooler host — "pooler.supabase.com"), append `?pgbouncer=true`. Without it,
# Prisma's interactive transactions ($transaction(async (tx) => ...), used by
# member delete, soul-win baptize/update, and NBC enrollment) can fail at
# runtime with "Transaction API error: Transaction not found" once the pooler
# recycles the connection Prisma pinned for that transaction. Also add
# `&connection_limit=<n>` sized to what the pooler allows per client, since
# each process (API server, worker) opens its own Prisma connection pool
# against the same pooler slot.
DATABASE_URL=

# Cloudflare R2 — create the bucket once in the Cloudflare dashboard
# (R2 > Create bucket) and a scoped API token (R2 > Manage API tokens) with
# Object Read & Write on that bucket only. Must stay a PRIVATE bucket; all
# file access is via short-lived presigned URLs, never public URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

FILE_STORAGE_MAX_UPLOAD_MB=50
# Cosmetic total shown in the storage-usage widget, computed from this app's
# own DB (not read from Cloudflare). 10 matches R2's free-tier storage
# allowance — raise once on paid usage.
FILE_STORAGE_QUOTA_GB=10

# Redis — backs the BullMQ queue that generates file thumbnails in the
# background. Optional: without it, uploads still succeed but no thumbnail
# worker runs, so files stay at thumbnailStatus NONE until it's configured.
REDIS_URL=redis://localhost:6379
# Thumbnail jobs one worker process runs at once (npm run worker). Tune to
# the worker container's CPU count — ffmpeg/sharp/pdf-to-img are CPU-heavy.
THUMBNAIL_WORKER_CONCURRENCY=2

JWT_SECRET=
JWT_EXPIRES_IN=7d

APP_API_KEY=

FRONTEND_URL=http://localhost:3000
APP_NAME=Management System

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Separate cap for PUT /attendance/:memberId (click-to-update)
ATTENDANCE_UPSERT_RATE_LIMIT_MAX=100

# Optional — when unset, account emails are logged instead of sent
RESEND_API_KEY=
RESEND_FROM=Management System <onboarding@resend.dev>

# How long the /set-password invite link stays valid
PASSWORD_SETUP_TOKEN_EXPIRES_IN_HOURS=48

# Log Prisma SQL slower than this (ms). 0 = off. Use ~200 locally before adding Redis.
SLOW_QUERY_MS=200

# Member auto status: inactive if last attendance (else createdAt) is older than this.
# Examples: 30d | 4w | 30 days | 4 weeks
# Cron (daily 02:00): npm run jobs:install-member-status-cron
MEMBER_INACTIVE_AFTER=4w
# Optional --loop only (prefer cron)
MEMBER_STATUS_SYNC_INTERVAL_MS=86400000
