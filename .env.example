NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

DATABASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# File Storage — Supabase Storage bucket. Must stay a PRIVATE bucket; all
# file access is via short-lived signed URLs, never public URLs.
# Create it with: npm run storage:init-bucket (requires SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_STORAGE_BUCKET=
# 50 matches the Supabase Free tier's per-file cap. If your project is on a
# paid plan with a higher limit (Dashboard > Settings > Storage), raise this
# to match — it isn't queryable from the API, only visible in the dashboard.
FILE_STORAGE_MAX_UPLOAD_MB=50
# Cosmetic total shown in the storage-usage widget — not enforced
FILE_STORAGE_QUOTA_GB=5

JWT_SECRET=
JWT_EXPIRES_IN=7d

APP_API_KEY=

FRONTEND_URL=http://localhost:3000
APP_NAME=Management System

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Separate cap for PUT /attendance/:memberId (click-to-update)
ATTENDANCE_UPSERT_RATE_LIMIT_MAX=100

# Optional — when unset, account emails are logged instead of sent
RESEND_API_KEY=
RESEND_FROM=Management System <onboarding@resend.dev>

# How long the /set-password invite link stays valid
PASSWORD_SETUP_TOKEN_EXPIRES_IN_HOURS=48

# Log Prisma SQL slower than this (ms). 0 = off. Use ~200 locally before adding Redis.
SLOW_QUERY_MS=200

# Member auto status: inactive if last attendance (else createdAt) is older than this.
# Examples: 30d | 4w | 30 days | 4 weeks
# Cron (daily 02:00): npm run jobs:install-member-status-cron
MEMBER_INACTIVE_AFTER=4w
# Optional --loop only (prefer cron)
MEMBER_STATUS_SYNC_INTERVAL_MS=86400000
